{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "dart.lineLength": 100,
  "dart.flutterSdkPath": null,
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.git": true
  }
}
